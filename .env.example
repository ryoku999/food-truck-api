DATABASE_URL=postgresql://postgres:change-me@localhost:5432/foodtruck

PORT=8000
NODE_ENV="development"
API_PREFIX="api"
CORS_ORIGINS="http://localhost:5173"



# rate limit
RATE_LIMIT_TTL=10
RATE_LIMIT_LIMIT=6000

# auth, jwt and cookie
AUTH_ACCESS_COOKIE_NAME="food-truck-access"
AUTH_REFRESH_COOKIE_NAME="food-truck-refresh"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE="lax"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_EXPIRES_IN="15m"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER="food-truck-api"
JWT_AUDIENCE="food-truck-clients"



# Copy the credentials, region and S3 endpoint from the RustFS environment.
RUSTFS_ACCESS_KEY=replace-with-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-rustfs-secret-key
RUSTFS_REGION=us-east-1
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000

# Private buckets for business assets and product images.
RUSTFS_BUSINESS_BUCKET=business
RUSTFS_PRODUCTS_BUCKET=products
RUSTFS_PRESIGNED_URL_EXPIRY_SECONDS=900
RUSTFS_MAX_IMAGE_SIZE=5242880
